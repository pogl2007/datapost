generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  plan          Plan      @default(FREE)
  planExpiresAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  datasets      Dataset[]
}

enum Plan {
  FREE
  PRO
}

model Dataset {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  fileName      String
  fileSize      Int
  rowCount      Int
  colCount      Int
  format        String
  status        DatasetStatus @default(PROCESSING)
  qualityScore  Int?
  issueCount    Int?
  criticalCount Int?
  summary       String?       @db.Text
  issues        Json?
  stats         Json?
  chatHistory   Json?
  originalFile  Bytes?
  cleanedFile   Bytes?
  createdAt     DateTime      @default(now())
  completedAt   DateTime?

  @@index([userId])
}

enum DatasetStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model DailyUsage {
  id      String @id @default(cuid())
  userId  String
  date    String
  uploads Int    @default(0)

  @@unique([userId, date])
}
